<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Si tienes el SDK de .NET 10 y tu App Service usa .NET 10, cambia a net10.0 y JwtBearer a 10.0.* -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IdentiTap.Api</RootNamespace>
    <AssemblyName>IdentiTap.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.*" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.*" />
    <PackageReference Include="Dapper" Version="2.*" />
    <PackageReference Include="MailKit" Version="4.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.*" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.*" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.*" />
    <PackageReference Include="Twilio" Version="7.*" />
  </ItemGroup>

</Project>
